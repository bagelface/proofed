---
interface Props {
  detailed?: boolean;
  animate?: boolean;
}

const { detailed = false, animate = false } = Astro.props;
const claims = ["Active since 2023", "Over 5,000 completed trips", "Rating above 4.8"];
const hidden = [
  { label: "Name", width: "62%" },
  { label: "Trip locations", width: "78%" },
  { label: "Earnings", width: "48%" },
  { label: "Passengers", width: "70%" },
];
---
<figure class:list={["credential", { animate }]} aria-label="Sample Proofed credential from Bolt">
  <div class="source">
    <span class="platform">Bolt</span>
    <span class="role">Ride-hailing driver, Nairobi</span>
  </div>

  <h3 class="group-title">Proven</h3>
  <ul class="claims">
    {claims.map((claim, i) => (
      <li style={`--i: ${i}`}>
        <svg class="check" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4L16 6" /></svg>
        <span>{claim}</span>
      </li>
    ))}
  </ul>

  <h3 class="group-title">Kept private</h3>
  <ul class="hidden-fields">
    {hidden.map((field, i) => (
      <li style={`--i: ${i}`}>
        <span class="field">{field.label}</span>
        <span class="bar" style={`--w: ${field.width}`}><span class="visually-hidden">hidden</span></span>
      </li>
    ))}
  </ul>

  {detailed && (
    <dl class="meta">
      <div><dt>Proven on</dt><dd>14 October 2026</dd></div>
      <div><dt>Expires</dt><dd>14 October 2027</dd></div>
      <div><dt>Session confirmed by</dt><dd>Independent attestor</dd></div>
    </dl>
  )}

  <figcaption class="status">
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" /><path d="M5.5 10.5l3 3L14.5 7" /></svg>
    <span>Proof checked and genuine</span>
  </figcaption>
</figure>

<style>
  .credential {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper-light);
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--orange);
    font-size: 1rem;
  }

  .source {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
  }

  .platform {
    font-size: 1.75rem;
    font-weight: 900;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }

  .role {
    color: var(--muted);
  }

  .group-title {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--brown);
  }

  .claims,
  .hidden-fields {
    display: grid;
    gap: 0.6rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .claims li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .check {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    padding: 0.15rem;
    background: var(--orange);
    fill: none;
    stroke: var(--paper-light);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hidden-fields li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    align-items: center;
    gap: 0.75rem;
  }

  .field {
    color: var(--muted);
  }

  .bar {
    display: block;
    width: var(--w);
    height: 0.95rem;
    background: var(--ink);
  }

  .meta {
    display: grid;
    gap: 0.4rem;
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--paper-deep);
  }

  .meta div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.75rem;
  }

  .meta dt {
    color: var(--muted);
  }

  .meta dd {
    margin: 0;
    font-weight: 600;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 2px solid var(--ink);
    font-weight: 700;
  }

  .status svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: #2c7a00;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 26rem) {
    .hidden-fields li,
    .meta div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  /* One load sequence: private fields are redacted first, then each claim is checked. */
  .animate .bar {
    transform-origin: left;
    animation: redact 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(500ms + var(--i) * 130ms);
  }

  .animate .check {
    animation: stamp 260ms ease-out both;
    animation-delay: calc(1250ms + var(--i) * 180ms);
  }

  .animate .status {
    animation: settle 300ms ease-out both;
    animation-delay: 1900ms;
  }

  @keyframes redact {
    from { transform: scaleX(0); }
  }

  @keyframes stamp {
    from { transform: scale(0.4); opacity: 0; }
  }

  @keyframes settle {
    from { opacity: 0; }
  }
</style>
