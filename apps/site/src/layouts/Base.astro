---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { href, repoUrl, breadUrl } from "../lib/url";

interface Props {
  title: string;
  description: string;
  tone?: "light" | "dark";
}

const { title, description, tone = "light" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { label: "For job seekers", path: "/job-seekers" },
  { label: "For employers", path: "/employers" },
  { label: "How it works", path: "/how-it-works" },
  { label: "About", path: "/about" },
];
const pageTitle = title === "Proofed" ? "Proofed: your work history, verified" : `${title} | Proofed`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#1b201a" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["site-header", { dark: tone === "dark" }]}>
      <div class="wrap header-inner">
        <a class="brand" href={href("/")} aria-label="Proofed home">
          <Logo class="brand-mark" />
          <span class="brand-name">Proofed</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={href(item.path)} aria-current={path.endsWith(item.path) ? "page" : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer dark">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-mark display">I'm proofed.</p>
          <p class="footer-note">Proofed is open source and built by members of <a href={breadUrl}>Bread Cooperative</a>.</p>
        </div>
        <ul class="footer-links">
          <li><a href={href("/job-seekers")}>For job seekers</a></li>
          <li><a href={href("/employers")}>For employers</a></li>
          <li><a href={href("/how-it-works")}>How it works</a></li>
          <li><a href={href("/demo")}>See a sample credential</a></li>
          <li><a href={href("/about")}>About</a></li>
          <li><a href={href("/privacy")}>Privacy</a></li>
          <li><a href={repoUrl}>Source code on GitHub</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    padding-block: 1.25rem;
  }

  .site-header:not(.dark) {
    border-bottom: 2px solid var(--ink);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    width: 2rem;
    height: 2rem;
  }

  .brand-name {
    font-size: 1.5rem;
    font-weight: 900;
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
  }

  .site-footer {
    padding-block: 4rem 3rem;
  }

  .footer-inner {
    display: grid;
    gap: 2.5rem;
  }

  .footer-mark {
    font-size: var(--step-3);
    color: var(--orange);
  }

  .footer-note {
    margin-top: 1.25rem;
    color: var(--paper-deep);
  }

  .footer-links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
  }

  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 2fr 1fr;
      align-items: end;
    }
  }
</style>
